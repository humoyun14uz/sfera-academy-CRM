# ============================================================
# Sfera Academy CRM — Environment Variables
# Copy this file to .env and fill in the values
# NEVER commit .env to version control
# ============================================================

# ---- Frontend (Vite) ----------------------------------------
# Clerk publishable key (safe to expose — used in browser)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME

# API base URL — for local dev the Vite proxy handles /api/v1 automatically
# Change this for production (e.g. https://api.yourdomain.com)
VITE_API_BASE_URL=/api/v1

# Optional realtime notifications endpoint.
# Example: ws://localhost:3000/notifications or wss://api.example.com/notifications
# Leave empty until the backend exposes the authenticated WebSocket gateway.
VITE_NOTIFICATION_WS_URL=

# ---- Backend (NestJS / apps/api) ----------------------------
# Node environment
NODE_ENV=development

# Server port
PORT=3000

# PostgreSQL connection string.
# MUST match the credentials created by docker-compose.yml:
#   POSTGRES_USER=sfera_user  POSTGRES_PASSWORD=sfera_password  POSTGRES_DB=sfera_academy_crm
DATABASE_URL=postgresql://sfera_user:sfera_password@localhost:5432/sfera_academy_crm

# Redis connection string (BullMQ background jobs)
REDIS_URL=redis://localhost:6379

# Clerk secret key (keep this SERVER-SIDE ONLY — never expose in VITE_*)
CLERK_SECRET_KEY=sk_test_REPLACE_ME

# CORS — comma-separated list of allowed origins
CORS_ORIGIN=http://localhost:5173

# ---- DEPRECATED — REMOVE IN PHASE 6 -------------------------
# The credentials below are consumed by the legacy client-side mock auth in
# src/features/auth/sign-in/components/user-auth-form.tsx. Because they are
# VITE_* values they ARE bundled into the browser JavaScript, so they grant no
# real security and must not exist in a production build (findings P0-4/P1-9).
# They can only be deleted once the frontend signs in against the API
# (Phase 2 + Phase 6); deleting them now would break the only working login.
VITE_ADMIN_EMAIL=admin@gmail.com
VITE_ADMIN_PASSWORD=SferaAdmin@2026
VITE_ADMIN_NAME=Sfera Administrator
VITE_MANAGER_EMAIL=manager@gmail.com
VITE_MANAGER_PASSWORD=SferaManager@2026
VITE_MANAGER_NAME=Manager
